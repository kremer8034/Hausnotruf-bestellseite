# Supabase – serverseitiger Zugriff (Datenbank, Dateiablage)
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase – Anmeldung im Browser.
# Der anon-Schlüssel darf öffentlich sein: auf allen Tabellen ist RLS aktiv
# und es gibt bewusst keine Policy.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse der Seite, wird für die Links in den Erinnerungsmails gebraucht
NEXT_PUBLIC_BASIS_URL=http://localhost:3000

# Schützt den täglichen Aufräumlauf unter /api/aufraeumen
# Erzeugen mit: openssl rand -hex 32
CRON_SECRET=
